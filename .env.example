# Copy to .env for local development. Never commit real keys.

# Set true to skip Gemini and return mock answers.
MOCK_LLM=true

# Required when MOCK_LLM=false.
GEMINI_API_KEY=

# Comma-separated browser origins allowed by CORS.
# Local default is http://localhost:3000
FRONTEND_URLS=http://localhost:3000

# Optional. Allow Vercel preview URLs, for example:
# FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# Production Docker images set this to true. Keep false for local uvicorn --reload
# unless you want FAISS + BGE loaded at process start.
WARMUP_ON_START=false

# Hugging Face artifact repo (public). Set HF_TOKEN only if the repo is private.
HF_ARTIFACTS_REPO=RiteshKushwaha01/supportiq-artifacts
HF_ARTIFACTS_REPO_TYPE=model
HF_TOKEN=
